# MongoDB Connection
MONGO_URL=mongodb://localhost:27017
# Or for MongoDB Atlas:
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bluewave?retryWrites=true&w=majority
DB_NAME=bluewave

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials (for seed script)
ADMIN_EMAIL=admin@bluewave.com
ADMIN_PASSWORD=Admin@123

# CORS Configuration (comma-separated origins, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

